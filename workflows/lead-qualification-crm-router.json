    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst tier = input.leadTier;\nconst industry = input.lead.industry;\n\nlet route;\n\nif (tier === \"HOT\" && industry === \"SaaS\") {\n  route = \"HOT_SaaS\";\n} else if (tier === \"HOT\" && industry === \"E-commerce\") {\n  route = \"HOT_Ecommerce\";\n} else if (tier === \"HOT\" && industry === \"Professional Services\") {\n  route = \"HOT_Professional_Services\";\n} else if (tier === \"HOT\") {\n  route = \"HOT_General\";\n} else if (tier === \"WARM\") {\n  route = \"WARM\";\n} else if (tier === \"COLD\") {\n  route = \"COLD\";\n} else {\n  route = \"UNROUTED\";\n}\n\nreturn [\n  {\n    json: {\n      ...input,\n      route\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        -32
      ],
      "id": "3c26e3b4-87d3-4d00-bb2a-085f116906b1",
      "name": "Determine Route"
    },
    {
      "parameters": {
