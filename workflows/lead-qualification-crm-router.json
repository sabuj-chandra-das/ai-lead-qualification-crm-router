      "id": "559028db-a79d-4cd0-b18b-e4a362e05b75",
      "name": "Create/Update HubSpot Contact"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst aiPainPoints = input.qualification?.pain_points || [];\n\nconst painPointText = aiPainPoints.join(\" \").toLowerCase();\n\nconst mappedPainPoints = [];\n\nif (\n  painPointText.includes(\"manual\") ||\n  painPointText.includes(\"inquiries manually\")\n) {\n  mappedPainPoints.push(\"Manual Processes\");\n}\n\nif (\n  painPointText.includes(\"customer\") ||\n  painPointText.includes(\"support\") ||\n  painPointText.includes(\"inquiries\")\n) {\n  mappedPainPoints.push(\"Customer Support\");\n}\n\nif (\n  painPointText.includes(\"high volume\") ||\n  painPointText.includes(\"hundreds\") ||\n  painPointText.includes(\"large volume\")\n) {\n  mappedPainPoints.push(\"High Support Volume\");\n}\n\nif (\n  painPointText.includes(\"repetitive\") ||\n  painPointText.includes(\"repetitive tasks\")\n) {\n  mappedPainPoints.push(\"Repetitive Tasks\");\n}\n\nif (\n  painPointText.includes(\"lead\") ||\n  painPointText.includes(\"lead management\")\n) {\n  mappedPainPoints.push(\"Lead Management\");\n}\n\nif (\n  painPointText.includes(\"data entry\") ||\n  painPointText.includes(\"data-entry\")\n) {\n  mappedPainPoints.push(\"Data Entry\");\n}\n\nif (\n  painPointText.includes(\"workflow\") ||\n  painPointText.includes(\"inefficien\")\n) {\n  mappedPainPoints.push(\"Workflow Inefficiency\");\n}\n\n// Remove duplicates\nconst uniquePainPoints = [...new Set(mappedPainPoints)];\n\nif (uniquePainPoints.length === 0) {\n  uniquePainPoints.push(\"Other\");\n}\n\nreturn [\n  {\n    json: {\n      ...input,\n      mappedPainPoints: uniquePainPoints\n    }\n  }\n];"
      },
