        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inputs\": [\n    {\n      \"id\": \"{{ $json.lead.email }}\",\n      \"idProperty\": \"email\",\n      \"properties\": {\n        \"email\": \"{{ $json.lead.email }}\",\n        \"firstname\": \"{{ $json.lead.firstName }}\",\n        \"lastname\": \"{{ $json.lead.lastName }}\",\n        \"phone\": \"{{ $json.lead.phone }}\",\n        \"company\": \"{{ $json.lead.company }}\",\n        \"jobtitle\": \"{{ $json.lead.jobTitle }}\",\n        \"website\": \"{{ $json.lead.website }}\",\n        \"lead_score\": \"{{ $json.leadScore }}\",\n        \"lead_tier\": \"{{ $json.leadTier }}\",\n        \"icp_fit\": \"{{ $json.qualification.ideal_customer_fit }}\",\n        \"buying_intent\": \"{{ $json.qualification.buying_intent }}\",\n        \"budget_level\": \"{{ $json.qualification.budget_level }}\",\n        \"authority_level\": \"{{ $json.qualification.authority_level }}\",\n        \"need_level\": \"{{ $json.qualification.need_level }}\",\n        \"timeline\": \"{{ $json.qualification.timeline }}\",\"pain_points\": \"{{ $json.mappedPainPoints.join(';') }}\",\n        \"ai_qualification_summary\": \"{{ $json.qualification.qualification_summary }}\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
