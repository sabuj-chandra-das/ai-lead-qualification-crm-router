    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"ideal_customer_fit\": {\n      \"type\": \"string\",\n      \"enum\": [\"Yes\", \"No\", \"Unknown\"]\n    },\n    \"buying_intent\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\", \"Unknown\"]\n    },\n    \"budget_level\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\", \"Unknown\"]\n    },\n    \"authority_level\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\", \"Unknown\"]\n    },\n    \"need_level\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\", \"Unknown\"]\n    },\n    \"timeline\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Immediate\",\n        \"Within 1 Month\",\n        \"1–3 Months\",\n        \"3–6 Months\",\n        \"6+ Months\",\n        \"Unknown\"\n      ]\n    },\n    \"pain_points\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"recommended_solution\": {\n      \"type\": \"string\"\n    },\n    \"qualification_summary\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"ideal_customer_fit\",\n    \"buying_intent\",\n    \"budget_level\",\n    \"authority_level\",\n    \"need_level\",\n    \"timeline\",\n    \"pain_points\",\n    \"recommended_solution\",\n    \"qualification_summary\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -144,
        192
      ],
      "id": "97b626b0-e7b0-4869-8322-a6c8a51c24f5",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\n\n// Get original lead from Validate & Normalize node\nconst original = $('Validate & Normalize').first().json;\n\nreturn [\n  {\n    json: {\n      lead: original.lead,\n      submittedAt: original.submittedAt,\n      qualification: aiResult.output\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -32
      ],
      "id": "4a15fe65-c059-4814-a853-597ed2ae16f2",
      "name": "Merge Lead + AI Result"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Helper\nconst clean = (value) => {\n  if (value === undefined || value === null) return '';\n  return String(value).trim();\n};\n\n// Read form fields\nconst firstName = clean(input[\"First Name\"]);\nconst lastName = clean(input[\"Last Name\"]);\nconst email = clean(input[\"Email\"]).toLowerCase();\nconst phone = clean(input[\"Phone\"]);\nconst company = clean(input[\"Company\"]);\nconst website = clean(input[\"Website\"]);\nconst jobTitle = clean(input[\"Job Title\"]);\nconst industry = clean(input[\"Industry\"]);\nconst companySize = clean(input[\"Company Size\"]);\nconst need = clean(input[\"What do you need?\"]);\nconst budget = clean(input[\"Budget\"]);\nconst timeline = clean(input[\"Timeline\"]);\nconst message = clean(input[\"Message\"]);\nconst leadSource = clean(input[\"Lead Source\"]);\n\n// Required-field validation\nconst errors = [];\n\nif (!firstName) errors.push(\"First Name is missing\");\nif (!lastName) errors.push(\"Last Name is missing\");\nif (!email) errors.push(\"Email is missing\");\nif (!company) errors.push(\"Company is missing\");\nif (!jobTitle) errors.push(\"Job Title is missing\");\nif (!industry) errors.push(\"Industry is missing\");\nif (!companySize) errors.push(\"Company Size is missing\");\nif (!need) errors.push(\"What do you need? is missing\");\nif (!budget) errors.push(\"Budget is missing\");\nif (!timeline) errors.push(\"Timeline is missing\");\nif (!message) errors.push(\"Message is missing\");\n\n// Basic email validation\nconst emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\nif (email && !emailValid) {\n  errors.push(\"Invalid email format\");\n}\n\n// Return normalized lead\nreturn [\n  {\n    json: {\n      lead: {\n        firstName,\n        lastName,\n        fullName: `${firstName} ${lastName}`.trim(),\n        email,\n        phone,\n        company,\n        website,\n        jobTitle,\n        industry,\n        companySize,\n        need,\n        budget,\n        timeline,\n        message,\n        leadSource\n      },\n      validation: {\n        valid: errors.length === 0,\n        errors\n      },\n      submittedAt: input.submittedAt || new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        -32
      ],
      "id": "b96dc433-5b71-4645-ba4f-7dfb8a7cdf4e",
      "name": "Validate & Normalize"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst q = input.qualification;\nconst lead = input.lead;\n\nlet score = 0;\n\n// ICP Fit — 20\nif (q.ideal_customer_fit === \"Yes\") {\n  score += 20;\n}\n\n// Authority — 15\nconst authorityPoints = {\n  High: 15,\n  Medium: 10,\n  Low: 5,\n  Unknown: 0\n};\nscore += authorityPoints[q.authority_level] || 0;\n\n// Budget — 20\nconst budgetPoints = {\n  High: 20,\n  Medium: 12,\n  Low: 5,\n  Unknown: 0\n};\nscore += budgetPoints[q.budget_level] || 0;\n\n// Need — 20\nconst needPoints = {\n  High: 20,\n  Medium: 12,\n  Low: 5,\n  Unknown: 0\n};\nscore += needPoints[q.need_level] || 0;\n\n// Timeline — 15\nconst timelinePoints = {\n  \"Immediate\": 15,\n  \"Within 1 Month\": 15,\n  \"1–3 Months\": 12,\n  \"3–6 Months\": 8,\n  \"6+ Months\": 3,\n  \"Unknown\": 0\n};\nscore += timelinePoints[q.timeline] || 0;\n\n// Problem clarity — 10\nif (Array.isArray(q.pain_points) && q.pain_points.length > 0) {\n  score += 10;\n}\n\n// Lead tier\nlet leadTier;\n\nif (score >= 80) {\n  leadTier = \"HOT\";\n} else if (score >= 50) {\n  leadTier = \"WARM\";\n} else {\n  leadTier = \"COLD\";\n}\n\nreturn [\n  {\n    json: {\n      lead,\n      qualification: q,\n      leadScore: score,\n      leadTier\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        -32
      ],
      "id": "7fb9cc82-66f9-4dc4-abbc-89f1a23e1365",
      "name": "Calculate Lead Score"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_HUBSPOT_PRIVATE_APP_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
